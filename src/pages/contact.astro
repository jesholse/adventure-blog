---
import DefaultLayout from "../layout/DefaultLayout.astro"
---
<DefaultLayout title="Kontakt">
        <section class="md:w-1/2 w-full mx-auto bg-white">
            <h2  class="text-3xl px-4 pb-0 md:text-center">Kontakt</h2>
                <form action="/contact/success" name="contact" class="md:p-10 p-4 flex flex-col gap-4 max-w-2xl mx-auto w-full " netlify>
                    <input placeholder="Email" name="Email" type="email" class="border-2 p-2" / required>
                    <textarea placeholder="Message" name="Message" class="border-2 p-2 h-44" required></textarea>
                    <button type="submit" class="text-black bg-sky-200 px-2 py-1  w-fit hover:bg-sky-300 ">Skicka</button>
                </form>
    </section>
</DefaultLayout>