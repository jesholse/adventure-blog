---
import type { GetStaticPaths } from "astro";
import CardTemplate from "../../components/CardTemplate.astro";
import DefaultLayout from "../../layout/DefaultLayout.astro";
import {getCollection} from "astro:content"
export const getStaticPaths = (async({paginate}) => {
    
    const posts = await getCollection("posts")
    const postsSorted = posts.sort((a, b)=> a.data.publishDate - b.data.publishDate).reverse()
    return paginate(postsSorted, {pageSize: 3});
}) satisfies GetStaticPaths;
const {page} = Astro.props
/* const res = await fetch("http://localhost:4321/api/categories.json")  
const categories = await res.json()
const categoriesFixed = categories?.categories.map((c)=>{ return `<a class="text-slate-500 hover:text-slate-800" href="/category/${c}">${c[0].toUpperCase() + c.substring(1)}</a>`}).join(", ")
 */
---

<DefaultLayout>
	<section transition:name="archive" class="flex flex-col md:flex-col flex-wrap" >
		<h2 class="text-3xl p-8 pb-0 w-1/2 mx-auto text-center p-4">Archive</h2>
<!--         <div  class="lg:w-1/2 mx-auto p-4 ">
           Kategorier: <div set:html={categoriesFixed}></div>
        </div> -->
    </section>
    <section class="flex flex-col md:flex-col flex-wrap"> 
	{page?.data.map((p)=>(<CardTemplate title={p.data.title} excerpt={p.data.excerpt} categories={p.data.category} slug={p.slug} image={p.data.image} publishDate={p.data.publishDate}></CardTemplate>))}
	</section>
    <section class="p-4 pb-8 flex flex-row justify-center w-full ">
        <div class="flex flex-row gap-2 text-white">
            {page?.url.prev ? <a class="px-2 py-1 bg-blue-400 w-fit hover:bg-blue-500 cursor-pointer" href={page.url.prev}>Previous page</a> : null}
            {page?.url.next ? <a class="px-2 py-1 bg-blue-400 w-fit hover:bg-blue-500 cursor-pointer" href={page.url.next}>Next page</a> : null} 
        </div>
    </section>
</DefaultLayout>
