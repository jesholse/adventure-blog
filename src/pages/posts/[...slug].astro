---
import DefaultLayout from "../../layout/DefaultLayout.astro";
import type { GetStaticPaths } from "astro";
import {getCollection} from "astro:content";
export const getStaticPaths = (async() => {
    const posts = await getCollection("posts")
    return posts.map((post)=>({
	    params: {slug: post.slug}, props: {post}
}))
}) satisfies GetStaticPaths;
const {post} = Astro.props;
const {Content} = await post.render()
console.log(post.slug)
const d = new Date(post.data.publishDate)
const year = d.getFullYear()
const month = d.getMonth()
const day = d.getDate()
const categoriesFixed = post.data.category.map((c)=>{ return `<a class="text-slate-500 hover:text-slate-800" href="/category/${c}">${c[0].toUpperCase() + c.substring(1)}</a>`}).join(", ")
---
<DefaultLayout title={post.data.title}>
     <section id="hero" class="flex flex-col lg:flex-col-reverse bg-white  md:w-1/2 w-full mx-auto p-4 pb-0">
		<!-- <div id="img-container" class="w-full ">
			<img  class="object-contain" src={post.data.image}/>
		</div> -->
		<div id="hero-text" class="w-full flex flex-col justify-center mx-auto py-2 ">
                    <h1 class="text-4xl text-blue-900 mb-2">{post.data.title}</h1>
			<div class="w-fit mx-auto ">
				<p class="text-lg">{post.data.excerpt}</p>
			</div>
		</div>
	</section> 
 
	<section transition:name={`article-${post.slug}`}  class="bg-white px-4  lg:w-2/4 md:mx-auto text-lg [&>p]:mb-4 [&>h2]:text-xl [&>h3]:text-slate-800 [&>h2]:text-blue-900 [&>h2]:font-medium [&>h3]:text-xl  [&>p>img]:mb-2 [&>p>sup]:text-blue-600 [&>.footnotes>ol]:list-decimal [&>.footnotes>ol]:px-2 [&>.footnotes>ol]:break-words  [&>ol>li]:text-slate-600  [&>ol]:pb-4 [&>ol>li]:underline-offset-4">

        <h2 class="">{post.data.subTitle}</h2>
        <Content></Content>
            
	</section>
       <section class="md:w-1/2 w-full mx-auto px-4 bg-white ">
            <div class="flex flex-row gap-4  items-center border-t-2 py-4 ">
                <img class="rounded-full w-10 h-10" src="/images/Default_pfp.jpg" alt="title"/> 
                <div class="flex flex-col text-sm gap-1">
                    <h4 >Jesper Holmlund</h4>
                    <time>{day}/{month+1}/{year}</time>
                      <!-- <div class="flex flex-row gap-2">
                        {
                        post.data.category.map((p)=>(
                            <a href={`/category/${p.toLocaleLowerCase()}`} class="text-slate-500 hover:text-slate-800 ">{p}</a>
                            ))
                        }
                        </div>  -->
                        <div set:html={categoriesFixed} class=""></div> 
                </div>
            </div>
    </section>

</DefaultLayout>
