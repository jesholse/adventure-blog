                    {
                    post.data.category.map((p)=>(
                        <a href={`/category/${p.toLocaleLowerCase()}`} class="text-slate-500 hover:text-slate-800 ">{p}</a>
                        ))
                    }
                  </div> -->
             </div>
	</section>
	<section class="lg:mt-4 px-4 md:w-2/4 md:mx-auto md:text-md">
		
	</section>
</DefaultLayout>
