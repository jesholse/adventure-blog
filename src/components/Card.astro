---
import { getCollection } from "astro:content"
const posts = await getCollection("posts")
---
{posts.map((post)=>(
<div class=" w-1/3 p-4">
    <article class="p-4 shadow-md   ">
        <h3 class="text-2xl pb-2">{post.data.title}</h3>
        <img src="/images/desert.jpg" alt="title"/>
        <div class="flex flex-row gap-4 p-4 border-b-2 items-center">
            <img class="rounded-full w-10 h-10" src="/images/desert.jpg" alt="title"/>
            <div class="flex flex-col text-xs gap-1">
                <h4 >Name</h4>
                <time>2011/01/01</time>
                <div class="flex flex-row gap-2">
                    {
                        post.data.category.map((p)=>(
                        <a href={`/category/${p.toLocaleLowerCase()}`} class="bg-green-200 rounded-md p-1 text-center text-xs hover:bg-green-300 cursor-pointer">{p}</a>
                        ))
                    }
                </div>
            </div>
        </div>
        <p class="text-slate-600 text-sm line-clamp-4 px-4 mt-4">Lorem ipsum dolor sit amet consectetur adipisicing elit. Numquam, voluptatem error nisi tempore necessitatibus repudiandae deleniti omnis veritatis quis recusandae beatae impedit, harum odio, neque veniam. Commodi harum doloremque possimus.</p>
        <div class="p-4">
            <a href={`/posts/${post.slug}`} class="text-sm px-2 py-1 bg-amber-400 w-fit block hover:bg-amber-500 cursor-pointer">Läs mer</a>
        </div>
    </article>
</div>
))}
