---
const {title, slug, categories, publishDate} = Astro.props
const today = new Date()
import { fade } from "astro:transitions"
---
<div class=" md:w-1/3 p-4">
<article class="md:p-4">
        <h3 class="text-2xl pb-2">{title}</h3>
        <img transition:name={slug} src="/images/desert.jpg" alt="title"/>
        <div class="flex flex-row  gap-4 p-2 md:p-4 border-b-2 border-b-lime-100 items-center ">
            <img  class="rounded-full w-12 h-12" src="/images/desert.jpg" alt="title"/>
            <div class="flex flex-col text-xs gap-1 b">
                <h4 >Name</h4>
                <time>{Math.round((today - new Date(publishDate)) /(1000 * 60 * 60 * 24))} days ago</time>
                <div class="flex flex-row gap-2 flex-wrap">
                    {
                    categories.map((p)=>(
                        <a href={`/category/${p.toLocaleLowerCase()}`} class="bg-lime-200 rounded-md p-1 text-center text-xs hover:bg-lime-400 cursor-pointer">{p}</a>
                        ))
                    }
                </div>
            </div>
        </div>
        <p class=" text-sm line-clamp-4 md:px-4 mt-4">Lorem ipsum dolor sit amet consectetur adipisicing elit. Numquam, voluptatem error nisi tempore necessitatibus repudiandae deleniti omnis veritatis quis recusandae beatae impedit, harum odio, neque veniam. Commodi harum doloremque possimus.</p>
        <div class="md:p-4 py-2">
            <a href={`/posts/${slug}`} class="text-sm px-2 py-1 bg-lime-400 w-fit block hover:bg-lime-500 cursor-pointer">Läs mer</a>
        </div>
 </article>
 </div>
